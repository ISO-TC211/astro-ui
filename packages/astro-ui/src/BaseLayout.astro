---
import { foucScript } from './scripts/fouc'
import { loadGtag } from './scripts/gtag'
import type { SiteConfig } from './types'
import Header from './Header.astro'
import Footer from './Footer.astro'

interface Props {
  config: SiteConfig
  title?: string
  description?: string
}

const { config, title, description } = Astro.props

const pageTitle = title
  ? `${title} | ${(config.titleHtml ?? config.title).replace(/<[^>]*>/g, '')}`
  : (config.titleHtml ?? config.title).replace(/<[^>]*>/g, '')

const metaDescription = (description ?? config.description ?? '')
  .replace(/\s+/g, ' ')
  .slice(0, 160)

const showAnalytics = import.meta.env.PROD && !!config.googleAnalytics
if (showAnalytics) loadGtag(config.googleAnalytics!.id)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />

    {config.faviconSvg && <link rel="icon" type="image/svg+xml" href={config.faviconSvg} />}
    {config.faviconIco && (
      <link rel="shortcut icon" href={config.faviconIco} type="image/vnd.microsoft.icon" />
    )}

    <script is:inline set:html={foucScript} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />

    <style is:global>
      html {
        scroll-behavior: smooth !important;
      }
      body {
        margin: 0;
        font-feature-settings: 'kern' 1, 'liga' 1;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        background-color: #fff !important;
        color: #222 !important;
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif !important;
        opacity: 1 !important;
      }
      html.dark body {
        background-color: #0f172a !important;
        color: #f1f5f9 !important;
      }
      #nav-header {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        z-index: 50 !important;
        height: 64px !important;
      }
      main {
        padding-top: 64px !important;
      }
    </style>
  </head>

  <body class="bg-white dark:bg-slate-900 text-slate-900 dark:text-white antialiased">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header config={config} />
    <main id="main-content">
      <slot />
    </main>
    <Footer config={config} />
  </body>
</html>
